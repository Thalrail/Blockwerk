{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockwerk",
  "version": "0.1.0",
  "identifier": "de.blockwerk.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blockwerk – Bauplan",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost wss: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Bauplaner für Minecraft Bedrock Edition",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      }
    }
  }
}

    {
      "id": "leser.schema",
      "titel": "Das Schema der Bauspezifikation",
      "regel": "Die Bauspezifikation ist die einzige Verbindung vom Leser in die Planung. Sie beschreibt nur, WAS gebaut wird: Schema-Version und Versionsnummer der Spezifikation, Projekt (Name, Bauplatzgröße, Nullpunkt, Maßstab), Teile mit Art, Form aus Ebene 2 mit Größe und Proportionen, Lage als Beziehung zu einem anderen Teil oder zum Bauplatz, Funktionen als Bedarf, Stil, Wichtigkeit (muss, soll, kann) und Verbindungen. Keine Koordinaten, keine Blöcke, keine Schaltungen. Das Vokabular steht in dieser Regel als Daten; Prüfer, Briefing-Prompt und die Planung (Ebene 3) lesen dasselbe.",
      "parameter": {
        "schema": 1,
        "teilarten": [
          "turm",
          "halle",
          "mauer",
          "keller",
          "kuppelbau",
          "tor",
          "bruecke",
          "platz",
          "lager",
          "anlage"
        ],
        "relationen": {
          "mitte": "mittig bei {bezug}",
          "ecke-nordwest": "an der Ecke Nordwest bei {bezug}",
          "ecke-nordost": "an der Ecke Nordost bei {bezug}",
          "ecke-suedwest": "an der Ecke Südwest bei {bezug}",
          "ecke-suedost": "an der Ecke Südost bei {bezug}",
          "ueber": "über {bezug}",
          "unter": "unter {bezug}",
          "neben-norden": "nördlich neben {bezug}",
          "neben-osten": "östlich neben {bezug}",
          "neben-sueden": "südlich neben {bezug}",
          "neben-westen": "westlich neben {bezug}",
          "innen": "innerhalb von {bezug}"
        },
        "wichtigkeiten": [
          "muss",
          "soll",
          "kann"
        ],

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(node tools/orchestrierung/cli.js status *)",
      "Bash(node tools/orchestrierung/cli.js start *)",
      "Bash(node tools/orchestrierung/cli.js runde-ende *)",
      "Bash(node tools/orchestrierung/cli.js tore *)",
      "Bash(node tools/orchestrierung/cli.js paket *)",
      "Bash(node tools/orchestrierung/cli.js tests-ausfuehren *)",
      "Bash(node tools/orchestrierung/cli.js review-melden *)",
      "Bash(node tools/orchestrierung/cli.js befund-melden *)",
      "Bash(node tools/orchestrierung/cli.js uebernehmen *)",
      "Bash(node tools/orchestrierung/cli.js haupt-kontrolle *)",
      "Bash(node tools/orchestrierung/cli.js wiederherstellen *)",
      "Bash(node tools/orchestrierung/cli.js ende *)",
      "Bash(node tools/orchestrierung/cli.js abschluss *)",
      "Bash(node tools/karte.js *)",
      "Bash(npm test)",
      "Bash(npm run test:kurz)",
      "Bash(npm run test:orchestrierung)",
      "Bash(npm run test:pruefstein)",
      "mcp__codex-bridge__review_code",
      "mcp__codex-bridge__review_status"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git rebase *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Agent(blockwerk-entwickler-schwer)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-hook.js\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-hook.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-wache.js\""
          }
        ]
      }
    ]
  }
}
